{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-contest-service",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/src/Services/ContestService/ContestService.API/ContestService.API.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-submission-service",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/src/Services/SubmissionService/SubmissionService.API/SubmissionService.API.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-all-services",
            "dependsOn": [
                "build-contest-service",
                "build-submission-service"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}

